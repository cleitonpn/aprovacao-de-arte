rules_version = '2';

// Regras do Firestore.
//
// Aqui é onde a regra de negócio vira lei. A interface já impede o clique em
// "enviar" quando a arte não passou, mas interface se contorna; estas regras
// rodam no servidor do Google e não. É por isso que a validação do veredicto
// está duplicada: quem chamar a API direto também não consegue subir arte
// reprovada.
//
// Três públicos, três níveis de acesso:
//
// 1. O time interno entra com Google ou e-mail/senha, precisa do e-mail
//    verificado e tem que constar em `admins`. Lê e escreve tudo.
// 2. O expositor com projeto cadastrado usa uma sessão ANÔNIMA e o token do
//    link. O token é o ID do documento e é a credencial: sem ele não se chega
//    ao projeto, e listar a coleção é proibido para quem não é do time.
// 3. O expositor sem projeto usa a ferramenta aberta e só cria o envio dele.

service cloud.firestore {
  match /databases/{database}/documents {

    // A verificação de e-mail não é burocracia. Com o login por e-mail e senha
    // ligado, qualquer pessoa cria uma conta com o endereço que quiser. Se
    // bastasse constar em `admins`, daria para se cadastrar com o e-mail de um
    // analista que ainda não criou conta e entrar no lugar dele. Exigir a
    // verificação obriga a ter acesso à caixa de entrada.
    function ehAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function textoValido(v, maximo) {
      return v is string && v.size() > 1 && v.size() <= maximo;
    }

    // Cuidado com as contrabarras: dentro da string, '\\s' vira o regex \s.
    // Escrever '\\\\s' produziria \\s, que numa classe de caracteres significa
    // "nem contrabarra, nem a letra s" — e passaria a recusar todo e-mail que
    // tivesse um "s". Um erro silencioso e muito difícil de enxergar.
    function emailValido(v) {
      return v is string && v.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$');
    }

    function cadastroValido(c) {
      return c.keys().hasAll(['nome', 'email', 'feira', 'stand'])
        && textoValido(c.nome, 120)
        && textoValido(c.email, 160)
        && emailValido(c.email)
        && textoValido(c.feira, 160)
        && textoValido(c.stand, 160);
    }

    // A trava do negócio: só sobe arte aprovada, ou com ressalva desde que o
    // cliente tenha assumido o risco de forma explícita.
    function veredictoPermiteEnvio(d) {
      return d.veredicto == 'aprovado'
        || (d.veredicto == 'ressalva' && d.riscoAceito != null);
    }

    // Arquivo de apoio (logo, fonte, manual de marca) não tem veredicto: não é
    // peça impressa, não tem tamanho final nem resolução a conferir. Em troca
    // da isenção, exigimos que ele pertença a um projeto que existe de fato —
    // é o que impede a coleção de virar depósito de qualquer coisa.
    function envioDeApoioValido(d) {
      return d.tipoEnvio == 'avulso'
        && d.projetoId is string
        && exists(/databases/$(database)/documents/projetos/$(d.projetoId));
    }

    match /envios/{protocolo} {
      allow read: if ehAdmin();

      // Só criar, nunca alterar nem apagar: um envio é um registro histórico.
      // Como `create` falha se o documento já existe, ninguém sobrescreve o
      // envio de outro expositor nem adultera o próprio depois de feito.
      allow create: if request.auth != null
        && request.resource.data.protocolo == protocolo
        && cadastroValido(request.resource.data.cadastro)
        && request.resource.data.status == 'concluido'
        && request.resource.data.arquivo.tamanho is number
        && request.resource.data.arquivo.tamanho > 0
        && request.resource.data.arquivo.tamanho < 1024 * 1024 * 1024
        && (envioDeApoioValido(request.resource.data)
            || veredictoPermiteEnvio(request.resource.data));

      allow update, delete: if false;
    }

    // Os projetos: quais peças cada stand precisa entregar, e em que pé está
    // cada uma.
    //
    // Uma escolha consciente sobre ONDE cada trava mora. O prazo de envio e a
    // exigência de liberação para reenviar são checados na interface, não
    // aqui. Não é esquecimento: a mesma peça pode legitimamente ser reenviada
    // fora do prazo e sem pedido — quando fomos NÓS que reprovamos a prova e
    // pedimos a correção. Escrever essa exceção em linguagem de regras exigiria
    // cruzar provas com respostas dentro do documento, e um erro ali barraria
    // um cliente que está certo, no dia da feira. O risco assimétrico manda
    // errar para o lado de deixar passar.
    //
    // O que É travado aqui é o que seria grave forjar: a decisão do analista.
    // E como o painel do time monta o histórico a partir de `envios` — que o
    // expositor não lê nem escreve —, qualquer contorno aparece na tela em vez
    // de acontecer em silêncio.
    match /projetos/{token} {
      // Leitura por ID é liberada a qualquer sessão autenticada — inclusive a
      // anônima do expositor — porque o token de 12 caracteres aleatórios É a
      // credencial, e ele só existe no link enviado ao cliente. Listar a
      // coleção continua restrito ao time: sem `list`, ninguém varre os
      // projetos atrás do de outro cliente.
      allow get: if request.auth != null;
      allow list: if ehAdmin();

      allow create, delete: if ehAdmin();

      // Duas escritas possíveis, e a diferença é o coração do fluxo de
      // aprovação:
      //
      // - o time altera o projeto inteiro, incluindo `controle` (liberações,
      //   recusas, provas, status de impressão) e o prazo;
      // - o expositor só alcança os três campos das AÇÕES DELE: o que enviou
      //   (`entregas`), o que pediu (`pedidos`) e o que respondeu numa prova
      //   (`respostasProva`).
      //
      // É esta linha que impede o cliente de assinar a decisão do analista.
      // Com o link em mãos ele pode pedir uma versão nova, mas não pode
      // liberá-la; pode reprovar uma prova, mas não pode declarar a peça
      // impressa; e não encosta na medida cadastrada — se encostasse, a
      // ferramenta voltaria a aprovar arte contra medida errada, que é o
      // problema que o cadastro veio resolver.
      allow update: if ehAdmin()
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['entregas', 'pedidos', 'respostasProva']));
    }

    // A feira: nome e PRAZO FINAL de envio das artes.
    //
    // O prazo mora aqui, e não copiado dentro de cada projeto, porque projeto
    // novo tem que nascer já com o prazo da feira — sem depender de alguém
    // lembrar de reaplicar. Por isso o expositor precisa conseguir LER a feira
    // dele: é de onde a tela dele tira a data. Ler pelo ID não expõe nada (o
    // nome da feira ele já sabe), e listar continua restrito ao time.
    match /feiras/{feiraId} {
      allow get: if request.auth != null;
      allow list: if ehAdmin();

      // O expositor também ESCREVE aqui, de raspão: ao enviar arte, a
      // ferramenta carimba nome e data de atualização da feira.
      //
      // Cuidado com o `hasOnly` na alteração. Um `setDoc(..., {merge:true})`
      // faz `request.resource.data` ser o documento JÁ MESCLADO — ou seja, com
      // o `prazoEnvio` que estava lá. Checar `keys().hasOnly([...])` numa
      // atualização passaria a recusar todo envio a partir do dia em que a
      // feira ganhasse um prazo, e o erro apareceria como "registro do envio
      // recusado", longe da causa. Na alteração é `diff().affectedKeys()` que
      // vale: o que importa é o que ele MUDOU, não o que sobrou no documento.
      allow create: if ehAdmin()
        || (request.auth != null
            && request.resource.data.keys().hasOnly(['nome', 'atualizadaEm'])
            && textoValido(request.resource.data.nome, 160));

      allow update: if ehAdmin()
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['nome', 'atualizadaEm'])
            && textoValido(request.resource.data.nome, 160));

      allow delete: if ehAdmin();
    }

    // Allowlist do painel, agora gerenciada pela tela "Analistas".
    //
    // Quem já tem acesso pode liberar outra pessoa. É uma escolha consciente:
    // sem servidor nosso no meio, a alternativa seria voltar a depender do
    // console do Firebase a cada contratação. A lista deve ficar curta, e o
    // campo `criadoPor` registra quem liberou quem.
    match /admins/{email} {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.email == email || ehAdmin());
      allow create, update, delete: if ehAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
