# Configuração pública do Firebase (projeto aprovacao-de-arte-49bc3).
#
# Estes valores NÃO são segredo: o SDK do Firebase os expõe no navegador por
# definição. Quem protege os dados são as regras em firestore.rules — leitura
# só para quem estiver na coleção `admins`, escrita só pela Cloud Function.
VITE_FIREBASE_API_KEY=AIzaSyCfOKilIZtomFZQijxaJHjEYzLIWs6LyZ8
VITE_FIREBASE_AUTH_DOMAIN=aprovacao-de-arte-49bc3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aprovacao-de-arte-49bc3
VITE_FIREBASE_APP_ID=1:79256127257:web:852ef05dc1ccbfd3a6e788

# Endpoint da Cloud Function que assina o upload no Drive.
# Preencher DEPOIS do primeiro deploy (`firebase deploy --only functions`):
# https://southamerica-east1-aprovacao-de-arte-49bc3.cloudfunctions.net/envio
VITE_ENVIO_ENDPOINT=

# Token do evento. Entra na URL enviada ao expositor (…/?e=TOKEN) e impede que
# o endpoint fique aberto ao mundo. Precisa ser igual ao segredo TOKEN_EVENTO
# configurado na função.
VITE_EVENTO_TOKEN=

# Limite de tamanho por arquivo (MB)
VITE_TAMANHO_MAXIMO_MB=800
