# Configuração pública do Firebase (projeto aprovacao-de-arte-49bc3).
#
# Estes valores NÃO são segredo: o SDK do Firebase os expõe no navegador por
# definição. Quem protege os dados são as regras em firestore.rules — leitura
# só para quem estiver na coleção `admins`, escrita só pela Cloud Function.
VITE_FIREBASE_API_KEY=AIzaSyCfOKilIZtomFZQijxaJHjEYzLIWs6LyZ8
VITE_FIREBASE_AUTH_DOMAIN=aprovacao-de-arte-49bc3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aprovacao-de-arte-49bc3
VITE_FIREBASE_APP_ID=1:79256127257:web:852ef05dc1ccbfd3a6e788

# Endereço da Cloud Function que assina o upload no Drive. É previsível a
# partir do projeto e da região, então já vem preenchido — passa a responder
# assim que a função for publicada pela aba Actions do GitHub.
VITE_ENVIO_ENDPOINT=https://southamerica-east1-aprovacao-de-arte-49bc3.cloudfunctions.net/envio

# O token do evento NÃO fica aqui: este arquivo vai para o Git. Ele é injetado
# no build a partir do segredo TOKEN_EVENTO do repositório
# (Settings → Secrets and variables → Actions). Em desenvolvimento local, crie
# um arquivo .env.local com VITE_EVENTO_TOKEN=... se quiser testar o envio.
VITE_EVENTO_TOKEN=

# Limite de tamanho por arquivo (MB)
VITE_TAMANHO_MAXIMO_MB=800
