# Copie este arquivo para "functions/.env" e preencha.
# O .env NÃO vai para o Git — ele fica só na sua máquina e é publicado
# junto com a função no deploy.

# Frase difícil de adivinhar, da sua cabeça. É ela que impede o endereço da
# função de ficar aberto ao mundo. Precisa ser IGUAL ao VITE_EVENTO_TOKEN
# do arquivo .env da raiz do projeto.
TOKEN_EVENTO=

# Vindos do "ID do cliente OAuth" no Google Cloud Console
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Vindo do OAuth Playground
OAUTH_REFRESH_TOKEN=

# Pasta do Drive que recebe as artes. Já vem preenchida no código com a sua;
# só descomente se quiser trocar depois.
# DRIVE_PASTA_RAIZ=1O48_s3haaKpPX98BdBr8s_PggYUcC53H

# Restringe quem pode chamar a função. Deixe em branco enquanto testa.
# ORIGENS_LIBERADAS=https://cleitonpn.github.io
