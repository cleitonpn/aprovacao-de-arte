rules_version = '2';

// Regras do Storage.
//
// O expositor grava com uma sessão anônima do Firebase, criada sem nenhuma
// tela de login. Estas regras são o que impede esse acesso aberto de virar um
// depósito de qualquer coisa: limitam a pasta, o tipo e o tamanho.
//
// ATENÇÃO ao escrever regras aqui: o Storage conhece apenas `read` e `write`.
// Não existe `allow create` como no Firestore — usar isso nega toda gravação
// silenciosamente. A semântica de "só criar, nunca sobrescrever" se obtém
// combinando `resource == null` (não existe arquivo no caminho ainda) com
// `request.resource != null` (não é uma exclusão).
//
// Leitura é negada de propósito. O painel do time não lê pelo caminho: ele usa
// o link de download gerado no envio, que carrega um token próprio e continua
// funcionando. Assim ninguém consegue varrer o armazenamento procurando artes
// de outros clientes.

service firebase.storage {
  match /b/{bucket}/o {

    match /envios/{feiraId}/{arquivo} {
      allow read: if false;

      allow write: if request.auth != null
        && resource == null                                    // não sobrescreve
        && request.resource != null                            // não é exclusão
        && request.resource.size > 0
        && request.resource.size < 1024 * 1024 * 1024           // 1 GB
        && request.resource.contentType.matches('image/jpeg|image/png|application/pdf');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
