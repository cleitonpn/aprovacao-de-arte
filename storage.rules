rules_version = '2';

// Regras do Storage.
//
// O expositor grava com uma sessão anônima do Firebase, criada sem nenhuma
// tela de login. Estas regras são o que impede esse acesso aberto de virar um
// depósito de qualquer coisa: limitam a pasta, o tipo e o tamanho.
//
// ATENÇÃO ao escrever regras aqui: o Storage conhece apenas `read` e `write`.
// Não existe `allow create` como no Firestore — usar isso nega toda gravação
// silenciosamente. A semântica de "só criar, nunca sobrescrever" se obtém
// combinando `resource == null` (não existe arquivo no caminho ainda) com
// `request.resource != null` (não é uma exclusão).

service firebase.storage {
  match /b/{bucket}/o {

    // A leitura precisa existir nos dois prefixos: `getDownloadURL()` é uma
    // operação de leitura, e é ela que produz o link guardado no registro do
    // envio. Negar leitura aqui fazia o arquivo subir e o envio falhar logo em
    // seguida, deixando o arquivo órfão no armazenamento.
    //
    // Isto NÃO abre o acervo: listar a pasta continua proibido (não há regra
    // para o prefixo da feira), então é preciso saber o caminho exato do
    // arquivo — que carrega um protocolo aleatório. Na prática, a mesma
    // proteção do link com token.

    // Arte de peça: tipo estrito, limite alto (arquivo de grande formato).
    match /envios/{feiraId}/{arquivo} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && resource == null                                    // não sobrescreve
        && request.resource != null                            // não é exclusão
        && request.resource.size > 0
        && request.resource.size < 1024 * 1024 * 1024           // 1 GB
        && request.resource.contentType.matches('image/jpeg|image/png|application/pdf');
    }

    // Arquivos de apoio: logo, fontes, manual de marca.
    //
    // Prefixo separado de propósito. Estes arquivos precisam de tipos que a
    // arte não deve aceitar (SVG, EPS, ZIP) — misturá-los no mesmo caminho
    // obrigaria a afrouxar a regra da arte, e aí um .zip passaria a ser aceito
    // como peça para impressão. O limite menor é o que impede a pasta de apoio
    // de virar depósito de arquivo pesado.
    match /avulsos/{feiraId}/{arquivo} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && resource == null
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size < 200 * 1024 * 1024            // 200 MB
        && request.resource.contentType.matches('image/jpeg|image/png|image/svg\\+xml|application/pdf|application/postscript|application/zip');
    }

    // Nada mais é acessível — inclusive listar o conteúdo das pastas.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
